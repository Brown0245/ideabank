# Copy this file to .env.server, then enter your own key locally.
# .env.server is ignored by Git. Never add this key to EXPO_PUBLIC_ variables.
AI_API_KEY=

# Optional server settings. Restart npm run server after changing them.
AI_MODEL=gpt-4.1-mini
API_HOST=127.0.0.1

# To use AI from a phone on your trusted Wi-Fi, set API_HOST=0.0.0.0.
# For a separate browser origin, set AI_ALLOWED_ORIGIN to its exact origin.
